<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="smartAttend.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3059"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="SESSIONS" custom_title="0" dock_id="1" table="4,8:mainSESSIONS"/><dock_state state="000000ff00000000fd000000010000000200000649000003befc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000006490000011e00ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="ADMIN" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="63"/><column index="2" value="101"/><column index="3" value="171"/><column index="4" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="SESSIONS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="72"/><column index="2" value="73"/><column index="3" value="67"/><column index="4" value="156"/><column index="5" value="156"/><column index="6" value="43"/><column index="7" value="49"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT
    s.stu_ID,
    s.name,
    se.sub_ID,
    COUNT(DISTINCT se.session_ID) AS total_classes,
    COUNT(a.session_ID) AS present_classes,
    ROUND(
        COUNT(a.session_ID) * 100.0 /
        COUNT(DISTINCT se.session_ID),
        2
    ) AS attendance_percentage
FROM STUDENTS s
JOIN ENROLLMENTS e
    ON s.stu_ID = e.stu_ID
JOIN SESSIONS se
    ON e.sub_ID = se.sub_ID
LEFT JOIN ATTENDANCE a
    ON a.session_ID = se.session_ID
    AND a.stu_ID = s.stu_ID
GROUP BY s.stu_ID, s.name, se.sub_ID
ORDER BY se.sub_ID, s.stu_ID;</sql><current_tab id="0"/></tab_sql></sqlb_project>
